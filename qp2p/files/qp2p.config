# qp2p 的 LuCI 侧配置。
#
# 这里只放「用户可见的设置」。加入令牌、私钥、证书都在 /etc/qp2p/（0600），
# 由 qp2p 自己管理，不往 UCI 里抄一份，避免同一个密钥躺在两个地方。

config qp2p 'main'
	# 开机自启 / 总开关
	option enabled '0'

	# 信令服务地址，例如 https://qp2p.example.com
	option worker ''

	# 本机在成员列表里显示的名字，留空用主机名
	option name ''

	# 想固定的虚拟地址，留空由服务端分配
	option ip ''

	# 打洞用的 UDP 监听
	option bind '0.0.0.0'
	option port '51820'

	# 虚拟网卡
	option dev 'qp2p0'
	option mtu '1400'

	# 直连空闲多少秒断开，0 = 从不断开
	option idle '0'

	# 逗号或空格分隔
	option stun 'stun.cloudflare.com:3478 stun.miwifi.com:3478'

	# 额外走隧道的网段，空格分隔
	option routes ''

	# 防火墙：局域网 → qp2p（本机后面的设备能不能访问对端虚拟地址）
	option lan_access '1'
	# 防火墙：qp2p → 局域网（对端能不能访问本机后面的设备）
	option peer_to_lan '0'
	# 局域网所在的防火墙 zone
	option lan_zone 'lan'
